# ===========================================
# Railway Intelligence Platform - Environment
# ===========================================

# --- Node.js ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/railway-intelligence

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=railway-backend

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=info
